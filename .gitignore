# ==========================================
# 密钥与敏感资产安全保护 (严禁推送到远程仓库)
# ==========================================
.aiterm/
master.key
storage.db
*.key
*.pem
*.id_rsa
*.id_ed25519

# ==========================================
# Python 虚拟环境与编译缓存
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ==========================================
# Node.js 与前端构建产物
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 桌面端打包输出与临时目录
# ==========================================
build/
dist/
dist-electron/
backend-dist/
ai-terminal-desktop/dist-electron/
ai-terminal-desktop/backend-dist/
*.spec

# ==========================================
# 操作系统临时文件
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
